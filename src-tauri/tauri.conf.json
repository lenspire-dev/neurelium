{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Neurelium",
  "version": "0.0.1",
  "identifier": "app.neurelium.desktop",
  "build": {
    "beforeDevCommand": "bun run dev --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Neurelium",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://fra.cloud.appwrite.io wss://fra.cloud.appwrite.io; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
